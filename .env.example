# ==============================================================================
# EMLESS — Railway Template & Environment Variable Deployment Manifest
# ==============================================================================

# [VARIABLE CLASSIFICATION]:
# 1. USER INPUT          -> ADMIN_USERNAME, ADMIN_PASSWORD
# 2. AUTO GENERATED      -> SECRET_KEY
# 3. RAILWAY PROVIDED    -> PORT
# 4. RAILWAY REFERENCE   -> DOMAIN, MTPROXY_PUBLIC_HOST, MTPROXY_PUBLIC_PORT
# 5. APPLICATION DEFAULT -> DB_PATH, MTPROXY_ENABLED, MTPROXY_PORT, WORKERS, DEFAULT_TRANSPORT_MODE, CLOAK_WS_ENABLED

# ------------------------------------------------------------------------------
# 1. USER INPUT VARIABLES
# ------------------------------------------------------------------------------
# Administrator credentials for initial dashboard authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=StrongPass!123

# ------------------------------------------------------------------------------
# 2. AUTO GENERATED VARIABLES
# ------------------------------------------------------------------------------
# Cryptographic session & token signing key (Auto-generated & persisted on Volume if empty)
SECRET_KEY=8trpmjrrev6hcwqvqv6qhjve0fda6m2r

# ------------------------------------------------------------------------------
# 3. RAILWAY-PROVIDED RUNTIME VARIABLES
# ------------------------------------------------------------------------------
# Web application port dynamically assigned and mapped by Railway (Default 8080)
PORT=8080

# ------------------------------------------------------------------------------
# 4. RAILWAY REFERENCE VARIABLES
# ------------------------------------------------------------------------------
# Dynamically references the deployed Railway public domain: ${{RAILWAY_PUBLIC_DOMAIN}}
DOMAIN=${{RAILWAY_PUBLIC_DOMAIN}}
RAILWAY_PUBLIC_DOMAIN=

# Dynamically references Railway TCP proxy host & port for Telegram MTProto:
# MTPROXY_PUBLIC_HOST=${{RAILWAY_TCP_PROXY_DOMAIN}}
# MTPROXY_PUBLIC_PORT=${{RAILWAY_TCP_PROXY_PORT}}
MTPROXY_PUBLIC_HOST=${{RAILWAY_TCP_PROXY_DOMAIN}}
MTPROXY_PUBLIC_PORT=${{RAILWAY_TCP_PROXY_PORT}}

# ------------------------------------------------------------------------------
# 5. APPLICATION DEFAULT VARIABLES & PERSISTENCE
# ------------------------------------------------------------------------------
# Database path mounted directly on Railway Persistent Volume (/data)
DB_PATH=/data/panel.db

# Optional remote PostgreSQL connection string: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Telegram MTProto internal listener port & switch
MTPROXY_ENABLED=true
MTPROXY_PORT=${{RAILWAY_TCP_APPLICATION_PORT}}

# Concurrency workers
WORKERS=4

# RVG Modular Transport Layer (Cloak WS Anti-Censorship Mode)
DEFAULT_TRANSPORT_MODE=standard
CLOAK_WS_ENABLED=true
CLOAK_WS_DEFAULT_PATH=/cloak-stream
CLOAK_WS_MASK_SNI=www.cloudflare.com
